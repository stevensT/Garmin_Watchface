<resources xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://developer.garmin.com/downloads/connect-iq/resources.xsd">
    <watchface-config>

        <!-- Layout presets. Minimal is the daily-wear face; Full turns on every slot. -->
        <styles>
            <style id="1" label="@Strings.StyleMinimal" default="true"/>
            <style id="2" label="@Strings.StyleFull"/>
        </styles>

        <!--
            Colour of the main HH:MM readout, chosen on the watch.

            A list rather than `allowAny`, because allowAny costs the default: the
            system picks its own starting colour for a free picker, and it picked
            white, so the face's own default never got a look in. A list can mark
            one entry `default="true"` and that is the colour a new install wears.
        -->
        <accentColors>
            <color label="@Strings.ColorGreen" default="true">0x00E676</color>
            <color label="@Strings.ColorWhite">0xFFFFFF</color>
            <color label="@Strings.ColorAmber">0xFFAA00</color>
            <color label="@Strings.ColorRed">0xFF4030</color>
            <color label="@Strings.ColorBlue">0x00AAFF</color>
        </accentColors>

        <!--
            The six data slots. Ids 1-6 come back as `uniqueIdentifier` in
            updateConfiguration() and must stay stable: the saved editor variants
            key on them.

            `allowAny` and <type> children are mutually exclusive - the SDK states
            that a type default should not be given alongside allowAny, and listing
            types pins the slot to that list. Every slot should offer the full
            complication list, so the per-slot defaults live in code instead (see
            Slots.defaultType), applied when the editor hands back a null
            complicationId - which is what it does for an untouched slot.
        -->
        <data>
            <complication id="1" allowAny="true"/>
            <complication id="2" allowAny="true"/>
            <complication id="3" allowAny="true"/>
            <complication id="4" allowAny="true"/>
            <complication id="5" allowAny="true"/>
            <complication id="6" allowAny="true"/>
        </data>

        <!-- Colour of the slot values. A short list reads better on-watch than a picker. -->
        <dataColors>
            <color label="@Strings.ColorWhite" default="true">0xFFFFFF</color>
            <color label="@Strings.ColorLightGray">0xC0C0C0</color>
            <color label="@Strings.ColorAmber">0xFFAA00</color>
            <color label="@Strings.ColorRed">0xFF4030</color>
            <color label="@Strings.ColorGreen">0x00AA55</color>
            <color label="@Strings.ColorBlue">0x00AAFF</color>
        </dataColors>

    </watchface-config>
</resources>
